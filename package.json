{
  "name": "ao3-tag-high-lighter",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "tsc --noEmit && tsc --noEmit -p e2e",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "e2e:capture": "node e2e/scripts/capture-fixtures.mjs",
    "verify": "npm run build && npm run lint && npm run test",
    "verify:release": "npm run verify && node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.57.0",
    "@types/node": "^24.19.2",
    "jsdom": "^25.0.1",
    "playwright-core": "1.57.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
